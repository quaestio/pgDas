# Copy to .env and edit. Never commit .env.
#
# PGDAS keeps its own data (users, saved servers, audit log) in a database of its own: PostgreSQL (PGDAS_APP_DB_* below) or one SQLite file.
# The PostgreSQL servers you browse are separate: they are added inside the app.

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
PGDAS_SECRET_KEY=
# Optional separate key for encrypting saved server passwords (a Fernet key). Defaults to one derived from the secret key.
PGDAS_ENCRYPTION_KEY=

# 1 for local development only (uses an insecure built-in key if PGDAS_SECRET_KEY is empty).
PGDAS_DEBUG=0
PGDAS_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to your https origin(s) when serving behind a reverse proxy, e.g. https://pgdas.example.com
PGDAS_CSRF_TRUSTED_ORIGINS=
# How many organizations this installation serves (set here only; nothing in the app can change it; restart to apply):
#   dedicated (default)  exactly one organization, created at /setup/
#   shared               many organizations, each with its own people, servers and audit log, completely separate
# PGDAS_MODE=dedicated
# Shared mode only: let visitors register an organization at /register/ (they become its first Super User). 0 = off (default).
# PGDAS_ALLOW_ORGANIZATION_REGISTRATION=0
# PGDAS_MAX_ORGANIZATIONS=            (shared mode; empty or 0 = no limit)
# PGDAS_REGISTRATIONS_PER_HOUR=5      (registration attempts per address per hour)
# With PGDAS_EMAIL_HOST set, a registration is confirmed by a link emailed to the new Super User (valid this many hours):
# PGDAS_REGISTRATION_CONFIRM_HOURS=48
# Reverse proxies whose X-Forwarded-For header is believed (comma separated addresses or ranges). Needed only when an organization
# restricts the addresses people may use and PGDAS runs behind a proxy; leave empty otherwise (the header is then ignored).
# PGDAS_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Where PGDAS keeps its own data: postgresql (default, recommended) or sqlite (one file, nothing to install: for trying PGDAS out
# or a single person; it allows one writer at a time, so people changing things together can meet "database is locked").
# PGDAS_APP_DB_ENGINE=postgresql
# PGDAS_SQLITE_PATH=data/pgdas.sqlite3        (sqlite only; the folder is created on first start)

# PGDAS's own PostgreSQL database (required when the engine is postgresql). Create it once, e.g.:
#   CREATE ROLE pgdas_app LOGIN PASSWORD '...';   CREATE DATABASE pgdas_identity OWNER pgdas_app;
# (give the role CREATEDB as well if you want to run the tests)
PGDAS_APP_DB_NAME=pgdas_identity
PGDAS_APP_DB_USER=pgdas_app
PGDAS_APP_DB_PASSWORD=
PGDAS_APP_DB_HOST=localhost
PGDAS_APP_DB_PORT=5432
# Use verify-full when the database is on another machine.
PGDAS_APP_DB_SSLMODE=prefer

# Safety limits for the SQL runner.
PGDAS_STATEMENT_TIMEOUT_MS=30000
PGDAS_MAX_ROWS=1000
# Most rows one table export (CSV, JSON or SQL) writes before it stops.
PGDAS_MAX_EXPORT_ROWS=100000
# Most rows one confirmed DELETE may remove: each is saved in the audit log (as JSON) so it can be re-inserted.
PGDAS_MAX_DELETE_ROWS=10000
# Most rows an UPDATE may touch and still be undoable: their old values are saved in the audit log (as JSON).
PGDAS_MAX_UNDO_ROWS=10000

# Backups: where pg_dump files are kept (default data/backups) and the folder with pg_dump / pg_restore (blank = on PATH).
# PGDAS_BACKUP_DIR=
# PGDAS_PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Alerts and size trends: how long samples are kept, and when an alert shows (seconds, percent, bytes).
# PGDAS_WATCH_KEEP_DAYS=90
# PGDAS_WATCH_BLOCKED_SECONDS=30
# PGDAS_WATCH_IDLE_TX_SECONDS=300
# PGDAS_WATCH_SLOW_SECONDS=300
# PGDAS_WATCH_CONNECTIONS_PERCENT=80
# PGDAS_WATCH_GROWTH_PERCENT=20
# PGDAS_WATCH_GROWTH_MIN_BYTES=104857600

# Sending alerts (run by `manage.py run_watch`). Set a webhook, email, or both; nothing is sent until you do.
# The webhook takes a JSON POST: a Slack, Teams or Discord incoming-webhook address works. Treat it as a secret.
# PGDAS_ALERT_WEBHOOK_URL=
# PGDAS_ALERT_EMAIL_TO=you@example.com,team@example.com
# PGDAS_ALERT_EMAIL_FROM=PGDAS <pgdas@example.com>
# PGDAS_EMAIL_HOST=smtp.example.com
# PGDAS_EMAIL_PORT=587
# PGDAS_EMAIL_USER=
# PGDAS_EMAIL_PASSWORD=
# PGDAS_EMAIL_TLS=1          # STARTTLS (port 587). For port 465 set PGDAS_EMAIL_SSL=1 instead.
# Remind about a critical alert that stays open every this many hours (0 = never).
# PGDAS_ALERT_REPEAT_HOURS=12

# Only for running the tests: a PostgreSQL server whose login can create databases.
# PGDAS_TEST_PG_HOST=localhost
# PGDAS_TEST_PG_PORT=5432
# PGDAS_TEST_PG_USER=postgres
# PGDAS_TEST_PG_PASSWORD=
