# Copy to .env and edit. Never commit .env.

# PgDeck's own settings database (PostgreSQL). It stores users, saved servers and the audit log,
# not the databases you manage.
PGDECK_DB_NAME=pgdeck
PGDECK_DB_USER=pgdeck
PGDECK_DB_PASSWORD=change-me
PGDECK_DB_HOST=localhost
PGDECK_DB_PORT=5432

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
PGDECK_SECRET_KEY=
# Optional separate key for encrypting saved server passwords (a Fernet key). Defaults to one derived from the secret key.
PGDECK_ENCRYPTION_KEY=

PGDECK_DEBUG=0
PGDECK_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to your https origin(s) when serving behind a reverse proxy, e.g. https://pgdeck.example.com
PGDECK_CSRF_TRUSTED_ORIGINS=

# Safety limits for the SQL runner.
PGDECK_STATEMENT_TIMEOUT_MS=30000
PGDECK_MAX_ROWS=1000
