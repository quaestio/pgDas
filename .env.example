# Copy to .env and edit. Never commit .env.
#
# PGDAS keeps its own data (users, saved servers, audit log) in one SQLite file, so there is no database to set up.
# The PostgreSQL servers you browse are added inside the app.

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
PGDECK_SECRET_KEY=
# Optional separate key for encrypting saved server passwords (a Fernet key). Defaults to one derived from the secret key.
PGDECK_ENCRYPTION_KEY=

# 1 for local development only (uses an insecure built-in key if PGDECK_SECRET_KEY is empty).
PGDECK_DEBUG=0
PGDECK_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to your https origin(s) when serving behind a reverse proxy, e.g. https://pgdeck.example.com
PGDECK_CSRF_TRUSTED_ORIGINS=

# Where PGDAS's own SQLite file lives. Default: data/pgdeck.sqlite3 next to manage.py.
# PGDECK_SQLITE_PATH=

# Safety limits for the SQL runner.
PGDECK_STATEMENT_TIMEOUT_MS=30000
PGDECK_MAX_ROWS=1000
# Most rows one confirmed DELETE may remove: each is saved in the audit log (as JSON) so it can be re-inserted.
PGDECK_MAX_DELETE_ROWS=10000
# Most rows an UPDATE may touch and still be undoable: their old values are saved in the audit log (as JSON).
PGDECK_MAX_UNDO_ROWS=10000

# Backups: where pg_dump files are kept (default data/backups) and the folder with pg_dump / pg_restore (blank = on PATH).
# PGDECK_BACKUP_DIR=
# PGDECK_PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Only for running the tests: a PostgreSQL server whose login can create databases.
# PGDECK_TEST_PG_HOST=localhost
# PGDECK_TEST_PG_PORT=5432
# PGDECK_TEST_PG_USER=postgres
# PGDECK_TEST_PG_PASSWORD=
