# Copy to .env and edit. Never commit .env.

# PGDAS's own settings database (PostgreSQL). It stores users, saved servers and the audit log,
# not the databases you manage.
PGDAS_DB_NAME=pgdas
PGDAS_DB_USER=postgres
PGDAS_DB_PASSWORD=Sou_mendas#123
PGDAS_DB_HOST=localhost
PGDAS_DB_PORT=5432

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
PGDAS_SECRET_KEY=
# Optional separate key for encrypting saved server passwords (a Fernet key). Defaults to one derived from the secret key.
PGDAS_ENCRYPTION_KEY=

PGDAS_DEBUG=1
PGDAS_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to your https origin(s) when serving behind a reverse proxy, e.g. https://pgdas.example.com
PGDAS_CSRF_TRUSTED_ORIGINS=

# Safety limits for the SQL runner.
PGDAS_STATEMENT_TIMEOUT_MS=30000
PGDAS_MAX_ROWS=1000

PGDAS_PG_BIN=E:\Program Files\PostgreSQL\18\bin

# PGDAS's own data (users, saved servers, audit log) lives in PostgreSQL. Moved from SQLite on 2026-11-03;
# the old file is data/pgdas.sqlite3 (and a timestamped backup next to it). Set PGDAS_APP_DB_ENGINE=sqlite to go back.
PGDAS_APP_DB_NAME=pgdas_identity
PGDAS_APP_DB_USER=pgdas_app
PGDAS_APP_DB_PASSWORD=FjuZteRTAvBxfjKeRuSfElZQ3IgB
PGDAS_APP_DB_HOST=localhost
PGDAS_APP_DB_PORT=5432
PGDAS_APP_DB_SSLMODE=prefer

# Dedicated (one organization) or shared (many organizations); public registration of organizations at /register/ (shared only)
PGDAS_MODE=shared
PGDAS_ALLOW_ORGANIZATION_REGISTRATION=1

# Servers PGDAS may connect to even though they are on this machine or a private network (a shared installation allows only public addresses otherwise)
PGDAS_ALLOWED_SERVER_HOSTS=localhost,127.0.0.1

# Email (registration confirmation links, alerts). Plain, no SSL/TLS.
PGDAS_EMAIL_HOST=mail.pgdas.org
PGDAS_EMAIL_PORT=587
PGDAS_EMAIL_SSL=0`nPGDAS_EMAIL_TLS=0
PGDAS_EMAIL_USER=no-reply@pgdas.org
PGDAS_EMAIL_PASSWORD="Sprihan#2012"
PGDAS_ALERT_EMAIL_FROM=PGDAS <no-reply@pgdas.org>

